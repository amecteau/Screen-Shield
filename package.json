{
  "name": "screen-shield",
  "version": "0.1.0",
  "description": "Transparent overlay for blurring screen regions during screen shares",
  "author": "ScreenShield",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"vite build --config vite.main.config.ts --watch\" \"vite --config vite.renderer.config.ts\"",
    "dev:electron": "electron .",
    "build": "npm run build:main && npm run build:overlay && npm run build:settings",
    "build:main": "vite build --config vite.main.config.ts",
    "build:overlay": "vite build --config vite.renderer.overlay.config.ts",
    "build:settings": "vite build --config vite.renderer.settings.config.ts",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\"",
    "typecheck": "tsc --noEmit",
    "precommit": "npm run typecheck && npm run lint && npm run test",
    "package": "npm run build && electron-builder --config electron-builder.yml",
    "package:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "package:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "package:linux": "npm run build && electron-builder --linux --config electron-builder.yml",
    "publish": "npm run build && electron-builder --publish always --config electron-builder.yml"
  },
  "dependencies": {
    "electron-store": "^9.0.0",
    "electron-updater": "~6.8.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "~40.5.0",
    "electron-builder": "~26.8.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "happy-dom": "^17.0.0",
    "playwright": "^1.52.0",
    "prettier": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.3",
    "vite": "~7.3.2",
    "vitest": "~4.1.5"
  }
}
